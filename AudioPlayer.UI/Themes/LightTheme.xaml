<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F6FA" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#E8ECF4" />
    <SolidColorBrush x:Key="AlternateBackgroundBrush" Color="#F7F8FB" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B1E25" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#626A78" />
